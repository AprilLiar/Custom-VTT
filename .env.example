# Turso credentials — leave unset to use a local SQLite file (local.db) instead,
# which is what local development does by default.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# How long boot waits for the primary to answer before giving up and exiting
# (milliseconds, default 10000). Opening the replica is a synchronous libSQL
# call that CANNOT be timed out from JavaScript, so an unreachable primary
# would otherwise hang the process forever with no output at all — this probe
# is the interruptible check that runs first. Set to 0 to skip it.
# TURSO_PROBE_TIMEOUT_MS=10000
